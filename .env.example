# CORS_ALLOWED_ORIGINS=https://savin-admin.vercel.app,https://savin-biznes-kassir.vercel.app
# CSRF_TRUSTED_ORIGINS=https://savin-backend-production.up.railway.app
# DEMO_PAYMENTS=True
