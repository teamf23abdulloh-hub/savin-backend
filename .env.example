# Savin backend — muhit o'zgaruvchilari namunasi.
#
# Ishlatish: shu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
#   cp .env.example .env          (Windows: copy .env.example .env)
#
# `.env` `.gitignore` da — u hech qachon git'ga tushmaydi.
# Hostingda (Railway / Render) `.env` emas, panelning "Variables" bo'limi
# ishlatiladi; haqiqiy muhit o'zgaruvchisi har doim `.env` dan ustun turadi.


# --- Django ---
DJANGO_DEBUG=True
# Production'da MAJBURIY (tasodifiy uzun satr):
# DJANGO_SECRET_KEY=
# DATABASE_URL=postgresql://...


# --- SMS (Eskiz.uz) ---------------------------------------------------------
#
# DIQQAT (vaqtinchalik): hozir SMS kredensiallari shu yerda emas,
# `mobileapi/sms_credentials.py` faylida turibdi — Eskiz tiketi kutilmoqda.
# Tiket hal bo'lgach qiymatlar shu yerga ko'chiriladi va o'sha fayl
# bo'shatiladi. Batafsil: README_DEPLOY.md, 5-bo'lim.
# Muhit o'zgaruvchisi fayldan HAR DOIM ustun.
# Ikkalasi ham to'ldirilsa SMS HAQIQATDA yuboriladi.
# Bo'sh qolsa — test rejimi: SMS ketmaydi, kod API javobida `dev_otp` bo'lib
# qaytadi va logga yoziladi (ilova baribir ishlaydi).
#
# Kabinet: https://my.eskiz.uz  ->  Sozlamalar -> API
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# SMS jo'natuvchi nomi (alphanumeric sender). Eskiz'da tasdiqlangan nom
# bo'lmasa 4546 (standart raqam) ishlatiladi.
ESKIZ_SENDER=4546

# OTP matni. Eskiz FAQAT moderatsiyadan o'tgan shablonni yuboradi va matn
# tasdiqlangan variantga AYNAN mos kelishi kerak. {code} kod bilan almashadi.
# SMS_OTP_TEMPLATE=Savin: tasdiqlash kodingiz {code}. Hech kimga aytmang.

# Kredensiallar bor bo'lsa ham SMS yubormaslik uchun (masalan xarajatni
# to'xtatish kerak bo'lganda): SMS_DEV_MODE=True
# SMS_DEV_MODE=False

# Eskiz hisobi hali "test" rolida bo'lsa yoki shablon tasdiqlanmagan bo'lsa,
# provayder haqiqiy matnni rad etadi. True qo'yilsa, shunday holatda Eskiz'ning
# standart test matni ("Bu Eskiz dan test") yuboriladi — SMS kanali ishlayotgani
# tekshiriladi, LEKIN foydalanuvchi kodni OLMAYDI, shuning uchun ro'yxatdan
# o'tish baribir "yuborilmadi" deb belgilanadi. Faqat tashxis uchun.
# ESKIZ_TEST_TEXT_FALLBACK=False

# `/api/v1/mobile/sms-status/` tashxis endpointini production'da ochish kaliti.
# Qo'yilmasa endpoint DEBUG=False da yopiq turadi.
# SMS_STATUS_TOKEN=


# --- Boshqa ---
